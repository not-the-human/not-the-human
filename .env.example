# ---------------------------------------------------------------------------
# CYBER NFC KIT - environment template
# Copy this file to .env.local and fill in real values. Never commit .env.local
# ---------------------------------------------------------------------------

# DatoCMS -------------------------------------------------------------------
# Read-only "Content Delivery API" token from Settings > API tokens in DatoCMS
DATOCMS_TOKEN=your_datocms_readonly_api_token
DATOCMS_ENDPOINT=https://graphql.datocms.com/

# Cloudinary ------------------------------------------------------------------
# Used client-side to build asset URLs and, optionally, for signed uploads
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
NEXT_PUBLIC_CLOUDINARY_BASE_FOLDER=cyber-nfc-kit
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# NVIDIA NIM (Llama 3 inference microservice) --------------------------------
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_KEY=your_nvidia_nim_api_key
NVIDIA_NIM_MODEL=meta/llama3-70b-instruct

# Nebius AI Studio (alternative inference backend) ---------------------------
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_API_KEY=your_nebius_api_key
NEBIUS_MODEL=meta-llama/Meta-Llama-3.1-70B-Instruct

# Tavily AI ------------------------------------------------------------------
TAVILY_API_KEY=tvly-_api_key

# App -------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_DEFAULT_AI_BACKEND=nvidia
